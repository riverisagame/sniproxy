[Unit]
Description=SNI Proxy - TLS SNI-based reverse proxy
Documentation=https://github.com/example/sniproxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sniproxy -c /etc/sniproxy/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Run as unprivileged user but allow binding port 443
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Security hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RemoveIPC=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
